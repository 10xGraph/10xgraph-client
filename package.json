{
  "name": "10xgraph-client",
  "version": "1.0.0-rc.2",
  "description": "TypeScript client for the 10xGraph API server: invoke and stream agent graphs, manage threads, memory and files, run client-side tools, and realtime audio. Formerly @10xscale/agentflow-client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}\\n')\" && vite build",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 253",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:open": "vitest run --coverage && xdg-open coverage/index.html",
    "check": "npm run lint && npm run typecheck && npm run test:run",
    "prepublishOnly": "npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10xGraph/10xgraph-client.git"
  },
  "bugs": {
    "url": "https://github.com/10xGraph/10xgraph-client/issues"
  },
  "homepage": "https://10xgraph.com",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "10xgraph",
    "10xscale",
    "agentflow",
    "ai-agents",
    "multi-agent",
    "agent",
    "llm",
    "typescript",
    "api-client",
    "sdk",
    "streaming",
    "sse",
    "websocket",
    "realtime-audio",
    "client-side-tools",
    "remote-tools",
    "threads",
    "memory",
    "react",
    "nodejs"
  ],
  "author": "Shudipto Trafder <shudiptotrafder@gmail.com>",
  "contributors": [
    {
      "name": "10xGraph",
      "url": "https://github.com/10xGraph"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
